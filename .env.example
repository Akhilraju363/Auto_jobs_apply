GEMINI_API_KEY=your_gemini_api_key_here

# Plain-text resume used for matching (relative to the project folder, or absolute)
RESUME_PATH=resume.txt

# Naukri job discovery (Phase 1). Keywords are comma-separated.
NAUKRI_ENABLED=true
NAUKRI_KEYWORDS=Java Full Stack Developer,Java Developer,Full Stack Developer,Software Engineer,Java Spring Boot Developer,Java Backend Developer
NAUKRI_LOCATION=
NAUKRI_EXPERIENCE=
NAUKRI_MAX_PAGES=5
NAUKRI_MAX_JOBS=50
APPLICATION_JOB_WINDOW_HOURS=24
APPLICATION_SCORE_THRESHOLD=8
PREFERRED_LOCATIONS=Bangalore,Chennai,Remote
NAUKRI_DELAY_MIN=2
NAUKRI_DELAY_MAX=5

# AI Agent file handoff (Phase 2). The AI Agent is a separate repository (job-application-ai-agent).
# AI_AGENT_OUTPUT_DIR: path to the AI Agent's output folder (scored_jobs.json is read from there).
AI_AGENT_OUTPUT_DIR=
# Where export-to-agent writes jobs for the AI Agent (point the AI Agent's NAUKRI_JOBS_PATH here).
NAUKRI_EXPORT_PATH=exports/naukri_jobs.json
# Max jobs per export (keep small: every job costs AI Agent LLM calls)
AI_AGENT_EXPORT_LIMIT=2

# Phase 3 application preparation. Naukri login uses your saved browser profile (chrome_user_data/);
# there is intentionally NO username/password setting. See docs/APPLICATION.md.
NAUKRI_APPLICATION_TIMEOUT=30
APPLICATION_MAX_JOBS=1
NAUKRI_LOGIN_WAIT_MINUTES=10
# Optional factual answers for application questions. Leave empty to always answer yourself.
APPLICANT_TOTAL_EXPERIENCE=
APPLICANT_CURRENT_LOCATION=
APPLICANT_PREFERRED_LOCATION=
APPLICANT_NOTICE_PERIOD=
APPLICANT_CURRENT_CTC=
APPLICANT_EXPECTED_CTC=
APPLICANT_PHONE=
APPLICANT_EMAIL=
# Optional preferences (true/false). Empty = you answer these questions yourself.
APPLICANT_WILLING_TO_RELOCATE=
APPLICANT_WORK_FROM_OFFICE=
APPLICANT_WORK_NIGHT_SHIFT=
APPLICANT_WORK_WEEKENDS=
# Master resume used only to confirm "do you have experience with X?" (default: the AI Agent's
# resume/base_resume.md next to AI_AGENT_OUTPUT_DIR). Read-only.
MASTER_RESUME_PATH=
# Phase 3.3 outcome tracking / recovery
NAUKRI_NAVIGATION_RETRIES=2       # page loads before Apply only; nothing after Apply is retried
CONFIRMATION_WAIT_SECONDS=20      # extra wait for a delayed Naukri confirmation
APPLICATION_DEBUG=true            # sanitized failure diagnostics (no page text, no answers)
APPLICATION_DEBUG_DIR=output/application_debug
